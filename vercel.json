{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/tutor/trace.ts": { "maxDuration": 30 },
    "api/tutor/chat.ts": { "maxDuration": 20 },
    "api/tutor/explain.ts": { "maxDuration": 30 }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
